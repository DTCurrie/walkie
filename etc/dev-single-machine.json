{
  "components": [
    {
      "name": "bus",
      "api": "rdk:component:generic",
      "model": "dtcurrie:walkie:bus",
      "attributes": {
        "channels": [{ "name": "ops" }, { "name": "logistics" }],
        "sample_rate": 16000,
        "num_channels": 1
      }
    },
    {
      "name": "uplink",
      "api": "rdk:component:audio_out",
      "model": "dtcurrie:walkie:uplink",
      "attributes": { "bus": "bus" }
    },
    {
      "name": "downlink",
      "api": "rdk:component:audio_in",
      "model": "dtcurrie:walkie:downlink",
      "attributes": { "bus": "bus" }
    },

    {
      "name": "mic",
      "api": "rdk:component:audio_in",
      "model": "viam:system-audio:microphone",
      "attributes": { "sample_rate": 16000, "num_channels": 1 }
    },
    {
      "name": "speaker",
      "api": "rdk:component:audio_out",
      "model": "viam:system-audio:speaker",
      "attributes": {}
    },
    {
      "name": "alpha",
      "api": "rdk:component:generic",
      "model": "dtcurrie:walkie:radio",
      "attributes": {
        "source": "mic",
        "sink": "speaker",
        "uplink": "uplink",
        "downlink": "downlink",
        "member": "alpha",
        "channel": "ops",
        "gate_mode": "manual",
        "sample_rate": 16000,
        "num_channels": 1
      }
    },
    {
      "name": "alpha-ptt",
      "api": "rdk:component:switch",
      "model": "dtcurrie:walkie:switch",
      "attributes": { "radio": "alpha", "mode": "ptt", "positions": ["idle", "talk"] }
    },
    {
      "name": "alpha-channel",
      "api": "rdk:component:switch",
      "model": "dtcurrie:walkie:switch",
      "attributes": {
        "radio": "alpha",
        "mode": "channel",
        "positions": ["ops", "logistics"]
      }
    },

    {
      "name": "fake-mic",
      "api": "rdk:component:audio_in",
      "model": "fake",
      "attributes": {}
    },
    {
      "name": "fake-speaker",
      "api": "rdk:component:audio_out",
      "model": "fake",
      "attributes": {}
    },
    {
      "name": "bravo",
      "api": "rdk:component:generic",
      "model": "dtcurrie:walkie:radio",
      "attributes": {
        "source": "fake-mic",
        "sink": "fake-speaker",
        "uplink": "uplink",
        "downlink": "downlink",
        "member": "bravo",
        "channel": "ops",
        "gate_mode": "manual"
      }
    }
  ],
  "modules": [
    {
      "type": "local",
      "name": "dtcurrie_walkie",
      "executable_path": "REPLACE-WITH-REPO-ROOT/bin/walkie"
    },
    {
      "type": "local",
      "name": "viam_system-audio",
      "executable_path": "REPLACE-WITH-HOME/.viam/local-modules/system-audio/bin/system-audio"
    }
  ]
}
